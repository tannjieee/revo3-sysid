#usda 1.0
(
    defaultPrim = "revo3_single"
    doc = "Identified REVO3 Ultra21 right-hand OpenUSD overlay (PhysX / Isaac Lab / Newton)."
    metersPerUnit = 1
    subLayers = [
        @../../assets/revo3_right/revo3_right.usd@
    ]
    upAxis = "Z"
)

